# Cloudflare account ID (found in the right sidebar of any zone/dashboard page)
CF_ACCOUNT_ID=your_account_id_here

# Cloudflare API token with "Stream: Edit" permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_api_token_here

# Simple password to protect the streamer dashboard (NOT your Cloudflare password)
# Anyone with this password can create/reset your stream and get the RTMP key
DASHBOARD_PASSWORD=change_this_to_something_only_you_know

# Port the server runs on
PORT=3000

# Public base URL of this server once deployed (used to build shareable watch links)
# e.g. https://stream.yourdomain.com  (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
